---
import Layout from '../../../layouts/Layout.astro';
import CardWorkbench from '../../../components/CardWorkbench.astro';
import { monthlyPeriods } from '../../../lib/monthly-reports';
export function getStaticPaths(){return monthlyPeriods.map(period=>({params:{period}}));}
const {period}=Astro.params;
---
<Layout title={`${period} 月度追踪 · 医学前沿追踪`} active="library"><section class="container card-page"><CardWorkbench mode="tracking" kind="monthly" period={period} title={`${period} 月度追踪`} /></section></Layout>
