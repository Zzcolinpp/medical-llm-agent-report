---
import { ArrowUpRight, BarChart3, BookOpen, Search } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import { surgeryReport } from '../../lib/surgery-report';

const base = import.meta.env.BASE_URL;
const reportPath = `${base}surgery/report/`;
const literaturePath = `${base}surgery/literature/`;
const journalCategories = surgeryReport.categories.filter((category) => !category.title.includes('预印本'));
const preprintCategories = surgeryReport.categories.filter((category) => category.title.includes('预印本'));
const coreCount = surgeryReport.papers.filter((paper) => paper.scope === 'core').length;
const edgeCount = surgeryReport.papers.filter((paper) => paper.scope === 'edge').length;
const preprintCount = surgeryReport.papers.filter((paper) => /arXiv|medRxiv|bioRxiv/i.test(paper.journal)).length;
const latestPapers = [...surgeryReport.papers].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 8);
const maxCategoryCount = Math.max(...journalCategories.map((category) => category.count));
const formatDate = (value: string) => value.replaceAll('-', '.');
const scopeLabel = (scope: string) => scope === 'edge' ? '边缘相关' : '核心相关';
---

<Layout
  title="手术 + AI 文献追踪报告"
  description="多期刊手术、外科、围手术期与人工智能交叉研究文献追踪报告。"
  active="surgery"
  reportLabel="手术 + AI 专题文献追踪报告"
  reportDate={surgeryReport.meta.retrievalDate}
  brandKicker="SURGERY + AI"
  brandSubline="OPERATIVE AI TRACKER"
>
  <section class="hero-band hero-band--surgery">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">SURGERY + AI · RESEARCH TRACKER</p>
        <h1>{surgeryReport.meta.title}</h1>
        <p class="hero-lede">从术中导航与手术视频，到机器人、自主操作、围手术期风险和外科治理，集中阅读手术与人工智能交叉研究的证据谱系。</p>
        <div class="hero-actions">
          <a class="button button--primary" href={reportPath}><BookOpen size={17} strokeWidth={1.8} aria-hidden="true" /><span>阅读全文</span></a>
          <a class="button button--secondary" href={literaturePath}><Search size={17} strokeWidth={1.8} aria-hidden="true" /><span>检索文献</span></a>
        </div>
        <dl class="report-meta-line">
          <div><dt>检索截止</dt><dd>{surgeryReport.meta.retrievalDate}</dd></div>
          <div><dt>追踪窗口</dt><dd>{surgeryReport.meta.trackingWindow}</dd></div>
          <div><dt>目标期刊与预印本</dt><dd>多期刊 · arXiv · medRxiv / bioRxiv</dd></div>
        </dl>
      </div>
      <div class="hero-note" aria-label="报告摘要">
        <div class="hero-note__rule"></div>
        <p class="eyebrow">SCOPE NOTE</p>
        <p>共收录 1323 篇唯一文献：期刊论文 782 篇、预印本 541 篇。附录完整清单仅作为原文参考，不重复计入索引。</p>
        <a class="text-link" href={`${reportPath}#section-检索与筛选策略-可复现`}>查看检索策略 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="stat-strip" aria-label="手术与 AI 报告统计">
    <div class="container stat-grid">
      <div class="stat-item"><strong>{surgeryReport.papers.length}</strong><span>唯一文献</span></div>
      <div class="stat-item"><strong>{coreCount}</strong><span>核心相关</span></div>
      <div class="stat-item"><strong>{edgeCount}</strong><span>边缘相关</span></div>
      <div class="stat-item"><strong>{preprintCount}</strong><span>预印本</span></div>
      <div class="stat-item"><strong>{journalCategories.length}</strong><span>期刊主题</span></div>
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div><p class="eyebrow">01 / JOURNAL DISTRIBUTION</p><h2>期刊论文主题分布</h2></div>
      <p class="section-note">期刊正文的 15 个主题保留原报告分类；预印本另列，避免不同来源混在同一统计口径中。</p>
    </div>
    <div class="container distribution-grid">
      <div class="bar-chart" role="img" aria-label="期刊论文主题文献数量分布">
        {journalCategories.map((category) => (
          <a class="chart-row" href={`${reportPath}#${category.id}`}>
            <span class="chart-label">{category.title.replace('【边缘相关】', '')}</span>
            <span class="chart-track"><span class:list={['chart-fill', { 'chart-fill--edge': category.isEdge }]} style={`--bar-width: ${(category.count / maxCategoryCount) * 100}%`}></span></span>
            <strong class="chart-count">{category.count}</strong>
          </a>
        ))}
      </div>
      <aside class="distribution-aside">
        <div class="aside-marker"><BarChart3 size={19} strokeWidth={1.7} aria-hidden="true" /></div>
        <h3>从术中感知到临床结局</h3>
        <p>导航、视频、机器人与围手术期预测共同构成手术 AI 的技术链路，治理与评价则决定这些系统能否进入真实工作流。</p>
        <a class="text-link" href={`${literaturePath}?scope=core`}>浏览核心相关文献 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>

  <section class="section-band section-band--tint">
    <div class="container section-heading-row">
      <div><p class="eyebrow">02 / PREPRINTS</p><h2>预印本专题</h2></div>
      <a class="text-link" href={`${literaturePath}?q=预印本`}>检索预印本 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container topic-grid">
      {preprintCategories.map((category, index) => (
        <a class="topic-link" href={`${reportPath}#${category.id}`}>
          <span class="topic-link__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="topic-link__title">{category.title}</span>
          <strong>{category.count}</strong>
          <ArrowUpRight size={16} strokeWidth={1.7} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div><p class="eyebrow">03 / LATEST PAPERS</p><h2>最近收录</h2></div>
      <a class="text-link" href={`${literaturePath}?sort=date`}>查看完整清单 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container paper-list paper-list--latest">
      {latestPapers.map((paper) => (
        <article class="paper-card paper-card--compact">
          <div class="paper-card__topline"><span class:list={['scope-badge', `scope-badge--${paper.scope}`]}>{scopeLabel(paper.scope)}</span><span>{formatDate(paper.date)}</span><span>{paper.journal}</span><span>{paper.articleType}</span></div>
          <h3><a href={`${reportPath}#${paper.slug}`}>{paper.titleZh}</a></h3>
          <p class="paper-card__english">{paper.titleEn}</p>
          <div class="paper-card__bottomline"><span>{paper.category}</span>{paper.pmidUrl && <a href={paper.pmidUrl}>PMID {paper.pmid}</a>}{paper.doiUrl && <a href={paper.doiUrl}>DOI <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}{paper.sourceUrl && !paper.pmidUrl && !paper.doiUrl && <a href={paper.sourceUrl}>原文 <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}</div>
        </article>
      ))}
    </div>
  </section>
</Layout>
