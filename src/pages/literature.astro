---
import Layout from '../layouts/Layout.astro';
import LiteratureExplorer from '../components/LiteratureExplorer.astro';
import { report } from '../lib/report';

const base = import.meta.env.BASE_URL;
const scopeCounts = {
  core: report.papers.filter((paper) => paper.scope === 'core').length,
  edge: report.papers.filter((paper) => paper.scope === 'edge').length,
  sister: report.papers.filter((paper) => paper.scope === 'sister').length
};
---

<Layout title="文献检索 · 医学 LLM / Agent 文献追踪" active="literature">
  <section class="page-intro-band">
    <div class="container page-intro">
      <div>
        <p class="eyebrow">LITERATURE INDEX · {report.papers.length} RECORDS</p>
        <h1>文献检索</h1>
        <p>在结构化索引中按主题、范围、文章类型和年份定位论文，再返回报告原文阅读上下文。</p>
      </div>
      <div class="page-intro__stats">
        <span><strong>{scopeCounts.core}</strong>核心</span>
        <span><strong>{scopeCounts.edge}</strong>边缘</span>
        <span><strong>{scopeCounts.sister}</strong>姊妹刊</span>
      </div>
    </div>
  </section>
  <section class="section-band section-band--compact">
    <div class="container">
      <LiteratureExplorer papers={report.papers} categories={report.categories} base={base} />
    </div>
  </section>
</Layout>
