---
import { ArrowUpRight, BarChart3, BookOpen, Search } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import { vlmReport } from '../../lib/vlm-report';

const base = import.meta.env.BASE_URL;
const reportPath = `${base}vlm/report/`;
const literaturePath = `${base}vlm/literature/`;
const coreCount = vlmReport.papers.filter((paper) => paper.scope === 'core').length;
const edgeCount = vlmReport.papers.filter((paper) => paper.scope === 'edge').length;
const latestPapers = [...vlmReport.papers]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8);
const maxCategoryCount = Math.max(...vlmReport.categories.map((category) => category.count));
const formatDate = (value: string) => value.replaceAll('-', '.');
const scopeLabel = (scope: string) => scope === 'edge' ? '边缘相关' : '核心相关';
const description = 'CNS+医学AI 深度学习、视觉语言模型、扩散与生成式模型专题文献追踪报告。';
---

<Layout
  title="深度学习 / VLM / 扩散模型 · 文献追踪"
  description={description}
  active="vlm"
  reportLabel="深度学习 / VLM / 扩散模型文献追踪报告"
  reportDate={vlmReport.meta.retrievalDate}
  brandKicker="CNS+ MEDICAL AI"
  brandSubline="VLM / DIFFUSION TRACKER"
>
  <section class="hero-band hero-band--vlm">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">CNS+ MEDICAL AI · RESEARCH TRACKER</p>
        <h1>{vlmReport.meta.title}</h1>
        <p class="hero-lede">
          横跨 24 本综合刊、顶级子刊与医学 AI 旗舰期刊，追踪医学基础模型、视觉语言模型、扩散生成和邻接深度学习方法的近一年进展。
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={reportPath}>
            <BookOpen size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>阅读全文</span>
          </a>
          <a class="button button--secondary" href={literaturePath}>
            <Search size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>检索文献</span>
          </a>
        </div>
        <dl class="report-meta-line">
          <div><dt>检索截止</dt><dd>{vlmReport.meta.retrievalDate}</dd></div>
          <div><dt>追踪窗口</dt><dd>{vlmReport.meta.trackingWindow}</dd></div>
          <div><dt>目标期刊</dt><dd>{vlmReport.meta.targetJournal}</dd></div>
        </dl>
      </div>
      <div class="hero-note" aria-label="报告摘要">
        <div class="hero-note__rule"></div>
        <p class="eyebrow">SCOPE NOTE</p>
        <p>正文纳入 3563 篇医学相关文献，另列 417 篇非医学方法学前沿；分类、摘要、要点和 PMID/DOI 均保留在原始报告上下文中。</p>
        <a class="text-link" href={`${reportPath}#section-检索与筛选策略-可复现`}>
          查看检索策略 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="stat-strip" aria-label="VLM 扩散报告统计">
    <div class="container stat-grid">
      <div class="stat-item"><strong>{vlmReport.papers.length}</strong><span>纳入文献</span></div>
      <div class="stat-item"><strong>{coreCount}</strong><span>医学相关</span></div>
      <div class="stat-item"><strong>{edgeCount}</strong><span>边缘相关</span></div>
      <div class="stat-item"><strong>{vlmReport.categories.length}</strong><span>主题类别</span></div>
      <div class="stat-item"><strong>24</strong><span>目标期刊</span></div>
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">01 / DISTRIBUTION</p>
        <h2>方法与场景分布</h2>
      </div>
      <p class="section-note">按报告正文最终纳入的主题分类统计，非医学方法学文献单独标识为边缘相关。</p>
    </div>
    <div class="container distribution-grid">
      <div class="bar-chart" role="img" aria-label="VLM 扩散报告主题文献数量分布">
        {vlmReport.categories.map((category) => (
          <a class="chart-row" href={`${reportPath}#${category.id}`}>
            <span class="chart-label">{category.title.replace('【边缘相关】', '')}</span>
            <span class="chart-track">
              <span
                class:list={['chart-fill', { 'chart-fill--edge': category.isEdge }]}
                style={`--bar-width: ${(category.count / maxCategoryCount) * 100}%`}
              ></span>
            </span>
            <strong class="chart-count">{category.count}</strong>
          </a>
        ))}
      </div>
      <aside class="distribution-aside">
        <div class="aside-marker"><BarChart3 size={19} strokeWidth={1.7} aria-hidden="true" /></div>
        <h3>从表征到生成</h3>
        <p>报告把基础模型、自监督表示、视觉语言、多模态生成、影像处理、组学建模和临床部署放在同一条方法谱系中阅读。</p>
        <a class="text-link" href={`${literaturePath}?scope=core`}>浏览医学相关文献 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>

  <section class="section-band section-band--tint">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">02 / LATEST PAPERS</p>
        <h2>最近收录</h2>
      </div>
      <a class="text-link" href={`${literaturePath}?sort=date`}>查看完整清单 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container paper-list paper-list--latest">
      {latestPapers.map((paper) => (
        <article class="paper-card paper-card--compact">
          <div class="paper-card__topline">
            <span class:list={['scope-badge', `scope-badge--${paper.scope}`]}>{scopeLabel(paper.scope)}</span>
            <span>{formatDate(paper.date)}</span>
            <span>{paper.category}</span>
          </div>
          <h3><a href={`${reportPath}#${paper.slug}`}>{paper.titleZh}</a></h3>
          <p class="paper-card__english">{paper.titleEn}</p>
          <div class="paper-card__bottomline">
            <span>{paper.journal}</span>
            {paper.pmidUrl && <a href={paper.pmidUrl}>PMID {paper.pmid}</a>}
            {paper.doiUrl && <a href={paper.doiUrl}>DOI <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">03 / TOPIC INDEX</p>
        <h2>按主题进入</h2>
      </div>
      <p class="section-note">每个主题都保留原始报告全文，并可跳转到结构化文献检索页进一步筛选。</p>
    </div>
    <div class="container topic-grid">
      {vlmReport.categories.map((category, index) => (
        <a class="topic-link" href={`${reportPath}#${category.id}`}>
          <span class="topic-link__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="topic-link__title">{category.title}</span>
          <strong>{category.count}</strong>
          <ArrowUpRight size={16} strokeWidth={1.7} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</Layout>
