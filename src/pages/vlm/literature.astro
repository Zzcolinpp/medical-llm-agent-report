---
import Layout from '../../layouts/Layout.astro';
import LiteratureExplorer from '../../components/LiteratureExplorer.astro';
import { vlmReport } from '../../lib/vlm-report';

const base = import.meta.env.BASE_URL;
const reportPath = `${base}vlm/report/`;
const scopeCounts = {
  core: vlmReport.papers.filter((paper) => paper.scope === 'core').length,
  edge: vlmReport.papers.filter((paper) => paper.scope === 'edge').length,
  sister: vlmReport.papers.filter((paper) => paper.scope === 'sister').length
};
---

<Layout
  title="文献检索 · 深度学习 / VLM / 扩散模型"
  description="按主题、范围、类型和年份检索深度学习、视觉语言模型、扩散生成与医学 AI 文献。"
  active="vlm-literature"
  reportLabel="深度学习 / VLM / 扩散模型文献追踪报告"
  reportDate={vlmReport.meta.retrievalDate}
  brandKicker="CNS+ MEDICAL AI"
  brandSubline="VLM / DIFFUSION TRACKER"
>
  <section class="page-intro-band">
    <div class="container page-intro">
      <div>
        <p class="eyebrow">VLM / DIFFUSION INDEX · {vlmReport.papers.length} RECORDS</p>
        <h1>文献检索</h1>
        <p>在 3980 篇结构化记录中按主题、范围、文章类型和年份定位论文，再返回报告原文阅读上下文。</p>
      </div>
      <div class="page-intro__stats">
        <span><strong>{scopeCounts.core}</strong>医学相关</span>
        <span><strong>{scopeCounts.edge}</strong>边缘相关</span>
        <span><strong>{scopeCounts.sister}</strong>姊妹刊</span>
      </div>
    </div>
  </section>
  <section class="section-band section-band--compact">
    <div class="container">
      <LiteratureExplorer papers={vlmReport.papers} categories={vlmReport.categories} base={base} reportPath={reportPath} />
    </div>
  </section>
</Layout>
