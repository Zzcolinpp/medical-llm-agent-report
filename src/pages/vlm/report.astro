---
import { Search } from 'lucide-astro';
import Layout from '../../layouts/Layout.astro';
import { vlmReport } from '../../lib/vlm-report';

const base = import.meta.env.BASE_URL;
const reportPath = `${base}vlm/report/`;
const literaturePath = `${base}vlm/literature/`;
const tocSections = vlmReport.sections.filter((section) => section.title !== '一图速览：分布');
---

<Layout
  title="报告全文 · 深度学习 / VLM / 扩散模型"
  description="CNS+医学AI 深度学习、视觉语言模型、扩散与生成式模型专题文献追踪报告全文。"
  active="vlm-report"
  reportLabel="深度学习 / VLM / 扩散模型文献追踪报告"
  reportDate={vlmReport.meta.retrievalDate}
  brandKicker="CNS+ MEDICAL AI"
  brandSubline="VLM / DIFFUSION TRACKER"
>
  <div class="container report-shell">
    <div class="report-tools">
      <span class="eyebrow">FULL REPORT · {vlmReport.meta.retrievalDate} · {vlmReport.papers.length} RECORDS</span>
      <a class="button button--secondary button--small" href={literaturePath}>
        <Search size={15} strokeWidth={1.8} aria-hidden="true" />
        <span>检索这份报告</span>
      </a>
    </div>
    <div class="report-layout">
      <aside class="report-toc" aria-label="报告目录">
        <div class="toc-title">目录</div>
        <nav>
          {tocSections.map((section) => (
            <a class:list={['toc-link', { 'toc-link--category': section.isCategory }]} href={`${reportPath}#${section.id}`}>
              <span>{section.title}</span>
              {section.count && <strong>{section.count}</strong>}
            </a>
          ))}
        </nav>
      </aside>
      <article class="report-document" set:html={vlmReport.html}></article>
    </div>
  </div>
</Layout>
