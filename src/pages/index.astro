---
import { ArrowUpRight, BookOpen, CalendarDays, Search } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import { catalogPapers, catalogStats, reportDomains } from '../lib/report-catalog';

const base = import.meta.env.BASE_URL;
const latestPapers = catalogPapers.slice(0, 8);
const latestDate = reportDomains.map((domain) => domain.report.meta.retrievalDate).sort().at(-1) ?? '';
const formatDate = (value: string) => value.replaceAll('-', '.');
const scopeLabel = (scope: string) => scope === 'edge' ? '边缘相关' : scope === 'sister' ? '姊妹刊' : '核心相关';
---

<Layout
  title="AI 医疗前沿 · 文献追踪"
  description="AI 医疗领域前沿文献追踪平台，提供三大领域年度报告、独立月度报告与跨领域文献检索。"
  active="home"
>
  <section class="hero-band">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI MEDICINE · FRONTIER LITERATURE TRACKER</p>
        <h1>AI 医疗前沿</h1>
        <p class="hero-lede">围绕医学视觉与基础模型、手术与围手术期 AI、医疗 LLM / Agent，持续整理年度报告与独立月度报告。</p>
        <div class="hero-actions">
          <a class="button button--primary" href={`${base}annual/`}>
            <BookOpen size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>阅读年度报告</span>
          </a>
          <a class="button button--secondary" href={`${base}search/`}>
            <Search size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>检索文献</span>
          </a>
        </div>
        <dl class="report-meta-line">
          <div><dt>覆盖领域</dt><dd>{catalogStats.domains} 个</dd></div>
          <div><dt>唯一文献</dt><dd>{catalogStats.uniqueRecords}</dd></div>
          <div><dt>数据更新至</dt><dd>{formatDate(latestDate)}</dd></div>
        </dl>
      </div>
      <div class="hero-note" aria-label="平台范围">
        <div class="hero-note__rule"></div>
        <p class="eyebrow">SCOPE NOTE</p>
        <p>保留每个专题报告的原始分类、摘要和深链接；跨领域检索按 PMID / DOI 去重，同时保留论文的多领域归属。</p>
        <a class="text-link" href={`${base}monthly/`}>
          <span>查看月度报告入口</span>
          <CalendarDays size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="stat-strip" aria-label="平台统计">
    <div class="container stat-grid stat-grid--four">
      {reportDomains.map((domain) => <div class="stat-item"><strong>{domain.report.papers.length}</strong><span>{domain.label}</span></div>)}
      <div class="stat-item"><strong>{catalogStats.uniqueRecords}</strong><span>去重后文献</span></div>
    </div>
  </section>

  <section class="section-band" aria-labelledby="annual-domain-title">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">01 / ANNUAL DOMAINS</p>
        <h2 id="annual-domain-title">三大领域年度报告</h2>
      </div>
      <a class="text-link" href={`${base}annual/`}><span>打开年度报告目录</span><ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container domain-preview-list">
      {reportDomains.map((domain, index) => (
        <a class="domain-preview" href={`${base}${domain.landingPath}`}>
          <span class="report-directory__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="domain-preview__body">
            <strong>{domain.label}</strong>
            <small>{domain.description}</small>
          </span>
          <span class="domain-preview__count">{domain.report.papers.length}<small>记录</small></span>
          <ArrowUpRight size={17} strokeWidth={1.7} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>

  <section class="section-band section-band--tint" aria-labelledby="latest-title">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">02 / LATEST PAPERS</p>
        <h2 id="latest-title">最近收录</h2>
      </div>
      <a class="text-link" href={`${base}search/?sort=date`}><span>查看完整索引</span><Search size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container paper-list paper-list--latest">
      {latestPapers.map((paper) => {
        const membership = paper.memberships[0];
        return (
          <article class="paper-card paper-card--compact">
            <div class="paper-card__topline">
              <span class:list={['scope-badge', `scope-badge--${paper.scope}`]}>{scopeLabel(paper.scope)}</span>
              <span>{paper.date}</span>
              <span>{membership.domainLabel}</span>
            </div>
            <h3><a href={`${base}${membership.reportPath}#${membership.slug}`}>{paper.titleZh}</a></h3>
            <p class="paper-card__english">{paper.titleEn}</p>
            <div class="paper-card__bottomline">
              <span>{paper.journal}</span>
              {paper.pmidUrl && <a href={paper.pmidUrl}>PMID {paper.pmid}</a>}
              {paper.doiUrl && <a href={paper.doiUrl}>DOI <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section-band monthly-callout" aria-labelledby="monthly-title">
    <div class="container monthly-callout__inner">
      <div>
        <p class="eyebrow">03 / MONTHLY READING</p>
        <h2 id="monthly-title">按月追踪正在发生的变化</h2>
        <p>独立月报导入后，会按年月、领域和二级分类生成连续的阅读入口。</p>
      </div>
      <a class="button button--secondary" href={`${base}monthly/`}>
        <CalendarDays size={17} strokeWidth={1.8} aria-hidden="true" />
        <span>进入月度报告</span>
      </a>
    </div>
  </section>
</Layout>
