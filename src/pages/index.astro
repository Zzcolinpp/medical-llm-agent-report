---
import { ArrowUpRight, BarChart3, BookOpen, Search } from 'lucide-astro';
import Layout from '../layouts/Layout.astro';
import { report } from '../lib/report';

const base = import.meta.env.BASE_URL;
const mainPapers = report.papers.filter((paper) => paper.scope !== 'sister');
const coreCount = report.papers.filter((paper) => paper.scope === 'core').length;
const edgeCount = report.papers.filter((paper) => paper.scope === 'edge').length;
const sisterCount = report.papers.filter((paper) => paper.scope === 'sister').length;
const latestPapers = [...report.papers]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 8);
const maxCategoryCount = Math.max(...report.categories.map((category) => category.count));
const formatDate = (value: string) => value.replaceAll('-', '.');
const scopeLabel = (scope: string) => scope === 'edge' ? '边缘相关' : scope === 'sister' ? '姊妹刊' : '核心相关';
---

<Layout
  title="医学 LLM / Agent 文献追踪报告"
  description="npj Digital Medicine 医学大语言模型、生成式 AI 与 Agent 专题文献追踪报告。"
  active="home"
>
  <section class="hero-band">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">NPJ DIGITAL MEDICINE · RESEARCH TRACKER</p>
        <h1>{report.meta.title}</h1>
        <p class="hero-lede">
          聚焦医疗大语言模型、生成式 AI 与 Agent 的近一年研究进展，按临床任务、模型能力、风险治理和证据类型重新组织。
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={`${base}report/`}>
            <BookOpen size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>阅读全文</span>
          </a>
          <a class="button button--secondary" href={`${base}literature/`}>
            <Search size={17} strokeWidth={1.8} aria-hidden="true" />
            <span>检索文献</span>
          </a>
        </div>
        <dl class="report-meta-line">
          <div><dt>检索截止</dt><dd>{report.meta.retrievalDate}</dd></div>
          <div><dt>追踪窗口</dt><dd>{report.meta.trackingWindow}</dd></div>
          <div><dt>目标期刊</dt><dd>{report.meta.targetJournal}</dd></div>
        </dl>
      </div>
      <div class="hero-note" aria-label="报告摘要">
        <div class="hero-note__rule"></div>
        <p class="eyebrow">SCOPE NOTE</p>
        <p>全量抓取目标期刊文献，宽召回筛选后逐篇摘要研判，并以 PubMed 与 Crossref 交叉校验。</p>
        <a class="text-link" href={`${base}report/#section-检索与筛选策略-可复现`}>
          查看检索策略 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="report-directory" aria-labelledby="report-directory-title">
    <div class="container report-directory__inner">
      <div class="report-directory__intro">
        <p class="eyebrow">REPORT LIBRARY · 04 TRACKS</p>
        <h2 id="report-directory-title">选择专题报告</h2>
        <p>四个独立专题共用同一套阅读、索引与深链接体验，可从这里切换研究视角。</p>
      </div>
      <div class="report-directory__list">
        <a class="report-directory__item" href={`${base}report/`}>
          <span class="report-directory__number">01</span>
          <span>
            <strong>医学 LLM / Agent</strong>
            <small>临床大语言模型、生成式 AI 与智能体</small>
          </span>
          <ArrowUpRight size={17} strokeWidth={1.7} aria-hidden="true" />
        </a>
        <a class="report-directory__item" href={`${base}vlm/`}>
          <span class="report-directory__number">02</span>
          <span>
            <strong>深度学习 / VLM / 扩散</strong>
            <small>医学视觉语言、多模态、生成式与基础模型</small>
          </span>
          <ArrowUpRight size={17} strokeWidth={1.7} aria-hidden="true" />
        </a>
        <a class="report-directory__item" href={`${base}surgery/`}>
          <span class="report-directory__number">03</span>
          <span>
            <strong>手术 + AI</strong>
            <small>术中导航、视频理解、机器人与围手术期 AI</small>
          </span>
          <ArrowUpRight size={17} strokeWidth={1.7} aria-hidden="true" />
        </a>
        <a class="report-directory__item" href={`${base}medical-agent/`}>
          <span class="report-directory__number">04</span>
          <span>
            <strong>生成式 AI / 对话式 AI / 智能体</strong>
            <small>35 种顶级医刊的 LLM、GenAI 与 Agent 追踪</small>
          </span>
          <ArrowUpRight size={17} strokeWidth={1.7} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="stat-strip" aria-label="报告统计">
    <div class="container stat-grid">
      <div class="stat-item"><strong>{mainPapers.length}</strong><span>目标期刊文献</span></div>
      <div class="stat-item"><strong>{coreCount}</strong><span>核心相关</span></div>
      <div class="stat-item"><strong>{edgeCount}</strong><span>边缘相关</span></div>
      <div class="stat-item"><strong>{report.categories.length}</strong><span>主题类别</span></div>
      <div class="stat-item"><strong>{sisterCount}</strong><span>姊妹刊参考</span></div>
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">01 / DISTRIBUTION</p>
        <h2>研究主题分布</h2>
      </div>
      <p class="section-note">按报告最终纳入的主题分类统计，边缘相关文献单独标识。</p>
    </div>
    <div class="container distribution-grid">
      <div class="bar-chart" role="img" aria-label="15 个主题的文献数量分布">
        {report.categories.map((category) => (
          <a class="chart-row" href={`${base}report/#${category.id}`}>
            <span class="chart-label">{category.title.replace('【边缘相关】', '')}</span>
            <span class="chart-track">
              <span
                class:list={['chart-fill', { 'chart-fill--edge': category.isEdge }]}
                style={`--bar-width: ${(category.count / maxCategoryCount) * 100}%`}
              ></span>
            </span>
            <strong class="chart-count">{category.count}</strong>
          </a>
        ))}
      </div>
      <aside class="distribution-aside">
        <div class="aside-marker"><BarChart3 size={19} strokeWidth={1.7} aria-hidden="true" /></div>
        <h3>从能力到落地</h3>
        <p>报告覆盖临床决策支持、医学智能体、多模态模型、基准评估、安全治理、患者沟通与科研辅助等完整链路。</p>
        <a class="text-link" href={`${base}literature/?scope=core`}>浏览核心相关文献 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
      </aside>
    </div>
  </section>

  <section class="section-band section-band--tint">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">02 / LATEST PAPERS</p>
        <h2>最近收录</h2>
      </div>
      <a class="text-link" href={`${base}literature/?sort=date`}>查看完整清单 <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" /></a>
    </div>
    <div class="container paper-list paper-list--latest">
      {latestPapers.map((paper) => (
        <article class="paper-card paper-card--compact">
          <div class="paper-card__topline">
            <span class:list={['scope-badge', `scope-badge--${paper.scope}`]}>{scopeLabel(paper.scope)}</span>
            <span>{formatDate(paper.date)}</span>
            <span>{paper.articleType}</span>
          </div>
          <h3><a href={`${base}report/#${paper.slug}`}>{paper.titleZh}</a></h3>
          <p class="paper-card__english">{paper.titleEn}</p>
          <div class="paper-card__bottomline">
            <span>{paper.journal}</span>
            {paper.pmidUrl && <a href={paper.pmidUrl}>PMID {paper.pmid}</a>}
            {paper.doiUrl && <a href={paper.doiUrl}>DOI <ArrowUpRight size={13} strokeWidth={1.8} aria-hidden="true" /></a>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-band">
    <div class="container section-heading-row">
      <div>
        <p class="eyebrow">03 / TOPIC INDEX</p>
        <h2>按主题进入</h2>
      </div>
      <p class="section-note">每一主题保留原始摘要与一句话要点，并可返回完整报告上下文。</p>
    </div>
    <div class="container topic-grid">
      {report.categories.map((category, index) => (
        <a class="topic-link" href={`${base}report/#${category.id}`}>
          <span class="topic-link__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="topic-link__title">{category.title}</span>
          <strong>{category.count}</strong>
          <ArrowUpRight size={16} strokeWidth={1.7} aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</Layout>
