---
import library from '../generated/card-library.json';
const { mode='library', topic='', kind='', period='', title='文献库', description=''  } = Astro.props;
const base=import.meta.env.BASE_URL;
const initialPapers=library.papers.filter(p=>(!topic||p.topics.includes(topic))&&p.sources.some(s=>library.batches.some(b=>b.id===s.batch&&(!kind||b.kind===kind)&&(!period||b.id.startsWith('monthly-'+period+'-'))))).slice(0,2);
const kinds=[['annual','年度追踪'],['monthly','月度追踪'],['selection','专题摘选'],['author','作者追踪']];
---
<div class="card-workbench" data-workbench data-mode={mode} data-topic={topic} data-kind={kind} data-period={period}>
 <section class="workspace-heading"><div><p class="eyebrow">MEDICAL FRONTIERS / LITERATURE LIBRARY</p><h1>{title}</h1>{description && <p class="reader-description">{description}</p>}</div><a class="backup-link" href={`${base}backups/`}>原始报告备份</a></section>
 <form class="card-search"><label class="sr-only" for="library-query">检索文献</label><input id="library-query" name="q" type="search" placeholder="标题、DOI、PMID、摘要、标签或笔记" /><button type="submit" disabled>检索文献</button></form>
 {mode==='home' && <nav class="tracking-nav" aria-label="追踪板块">{kinds.map(([id,label])=><a href={`${base}tracking/${id}/`}><strong>{label}</strong><span>{id==='author'?'尚未建立':`${new Set(library.papers.filter(p=>p.sources.some(s=>library.batches.some(b=>b.id===s.batch&&b.kind===id))).map(p=>p.id)).size} 篇文献`}</span></a>)}</nav>}
 <p class="workspace-status" role="status">{library.papers.length} 篇文献 · 正在读取编辑状态…</p>
 <button class="retry-library" type="button" hidden>重新读取</button>
 {(mode==='home'||mode==='topics') && <section class="home-topics"><div class="workspace-section-title"><h2>医学专题</h2><a href={`${base}topics/`}>全部专题</a></div><div data-home-topics class="medical-topic-grid">{library.topics.map(t=><a class="medical-topic-card" href={`${base}topics/${t.id}/`}><span>{t.group}</span><h3>{t.label}</h3><p>{t.description}</p><strong>{library.papers.filter(p=>p.topics.includes(t.id)).length} 篇</strong><div class="topic-storage-bar"><i style={`width:${library.papers.filter(p=>p.topics.includes(t.id)).length/library.papers.length*100}%`}></i></div></a>)}</div></section>}
 {mode==='tracking' && <section class="batch-panel"><h2>追踪批次与医学专题</h2><div data-batches class="batch-list"></div></section>}
 <section class="library-surface" hidden={mode==='topics'}>
 <div class="card-filters"><label>医学主题<select disabled name="topic"><option value="">全部主题</option>{library.topics.map(t=><option value={t.id}>{t.label}</option>)}</select></label><label>追踪批次<select disabled name="batch"><option value="">全部批次</option></select></label><label>阅读状态<select disabled name="reading"><option value="">全部状态</option><option>未读</option><option>阅读中</option><option>已读</option></select></label><label>证据状态<select disabled name="verification"><option value="">全部记录</option><option value="included">来源已收录</option><option value="pending">含待核验记录</option></select></label><label>发表年份<select disabled name="year"><option value="">全部年份</option></select></label><label>排序<select disabled name="sort"><option value="date">发表日期倒序</option><option value="title">标题</option><option value="updated">最近编辑</option></select></label></div>
 <div class="reader-layout">
  <aside class="reader-sidebar" aria-label="文献索引">
   <details class="reader-index" open>
    <summary class="toc-title">浏览文献索引 <span data-index-caption>按专题</span></summary>
    <div class="distribution-switch" role="group" aria-label="索引方式"><button type="button" data-distribution="category" disabled aria-pressed="true">专题索引</button><button type="button" data-distribution="journal" disabled aria-pressed="false">期刊索引</button></div>
    <p class="reader-index-help">点击条目筛选右侧文献。数字为篇数，色条显示当前范围内的分布。</p>
    <button type="button" class="index-all" data-index-all aria-pressed="true" disabled>全部文献 <strong data-index-total>…</strong></button>
    <nav data-chart class="reader-index-items" aria-label="专题或期刊列表"><p>正在读取索引…</p></nav>
    <p class="reader-index-note">同一篇文献可归入多个专题，各专题篇数不宜直接相加。</p>
   </details>
  </aside>
  <div class="reader-content">
   <section class="reader-results-heading" data-results-heading tabindex="-1" aria-labelledby="reader-results-title">
    <div class="workspace-section-title"><h2 id="reader-results-title" data-selection-title>全部文献</h2><button type="button" data-chart-reset hidden>显示全部文献</button></div>
    <p data-result-count role="status" aria-live="polite">正在整理文献…</p>
    <p class="reader-filter-context" data-filter-context></p>
   </section>
   <div class="reader-toolbar"><p>题录、摘要、笔记与补充信息完整展开</p><label>每页<select disabled name="page-size"><option value="10">10 篇</option><option value="20">20 篇</option><option value="50">50 篇</option></select></label></div>
   <nav class="card-pagination" data-pagination="top" aria-label="顶部翻页"><button type="button" data-prev disabled>上一页</button><div data-page-buttons></div><span data-page></span><button type="button" data-next disabled>下一页</button></nav>
   <div data-paper-list class="literature-cards">{initialPapers.map(p=><article class="literature-card"><div class="literature-card__meta">{p.journal} · {p.date}</div><h3>{p.titleZh||p.titleEn}</h3><p class="literature-card__summary">{p.summary||'原报告仅提供题录。'}</p></article>)}</div>
   <nav class="card-pagination" data-pagination="bottom" aria-label="底部翻页"><button type="button" data-prev disabled>上一页</button><div data-page-buttons></div><span data-page></span><button type="button" data-next disabled>下一页</button></nav>
  </div>
 </div>
 </section>
 <dialog class="card-dialog" aria-labelledby="detail-title"><div class="dialog-toolbar"><span>文献卡片</span><button type="button" data-close aria-label="关闭文献卡片">关闭</button></div><div data-detail></div></dialog>
</div>
<script>
 import '../scripts/card-workbench';
</script>
