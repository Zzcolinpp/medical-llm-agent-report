---
import { BookOpen, Search } from 'lucide-astro';
import '../styles/global.css';
import '../styles/portal.css';
import '../styles/cards.css';
import library from '../generated/card-library.json';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'topics' | 'library' | 'annual' | 'monthly' | 'search' | 'report' | 'literature' | 'vlm' | 'vlm-report' | 'vlm-literature' | 'surgery' | 'surgery-report' | 'surgery-literature' | 'medical-agent' | 'medical-agent-report' | 'medical-agent-literature';
  reportLabel?: string;
  reportDate?: string;
  brandKicker?: string;
  brandSubline?: string;
}

const {
  title,
  description = '按疾病与诊疗、数字医学与 AI 组织的医学研究报告门户。',
  active = 'home',
  reportLabel = '医学前沿追踪',
  reportDate = library.batches.map(b=>b.date).sort().at(-1),
  brandKicker: _brandKicker,
  brandSubline: _brandSubline
} = Astro.props;
const base = import.meta.env.BASE_URL;
const annualActive = active === 'annual' || active === 'report' || active === 'vlm' || active === 'vlm-report' || active === 'surgery' || active === 'surgery-report' || active === 'medical-agent' || active === 'medical-agent-report';
const searchActive = active === 'search' || active === 'literature' || active === 'vlm-literature' || active === 'surgery-literature' || active === 'medical-agent-literature';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#102544" />
    <meta name="site-base" content={base} />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={base} aria-label="医学前沿追踪首页">
          <span class="brand__mark">MF</span>
          <span class="brand__text">医学前沿追踪<br /><small>MEDICAL FRONTIERS</small></span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a class:list={['nav-link', { active: active === 'home' }]} href={base}>
            <span>总览</span>
          </a>
          <a class:list={['nav-link', { active: active === 'topics' || ['vlm', 'surgery', 'medical-agent'].includes(active) }]} href={`${base}topics/`}><span>医学专题</span></a>
          <a class:list={['nav-link', { active: active === 'library' || annualActive || active === 'monthly' }]} href={`${base}library/`}><BookOpen size={16} aria-hidden="true" /><span>文献库</span></a>
          <a class:list={['nav-link', { active: searchActive }]} href={`${base}search/`}>
            <Search size={16} strokeWidth={1.8} aria-hidden="true" />
            <span>文献检索</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <strong>{reportLabel}</strong>
          <p>研究信息整理，不构成医疗建议。论文详情请以原始出版物为准。</p>
        </div>
        <div class="site-footer__meta">
          <span>数据源：PubMed / NCBI E-utilities / Crossref</span>
          <span>检索截止：{reportDate}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
