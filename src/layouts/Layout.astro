---
import { ArrowUpRight, BookOpen, Search } from 'lucide-astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'report' | 'literature' | 'vlm' | 'vlm-report' | 'vlm-literature' | 'surgery' | 'surgery-report' | 'surgery-literature';
  reportLabel?: string;
  reportDate?: string;
  brandKicker?: string;
  brandSubline?: string;
}

const {
  title,
  description = '面向医学大语言模型、生成式 AI 与智能体研究的结构化文献追踪报告。',
  active = 'home',
  reportLabel = '医学 LLM / Agent 文献追踪报告',
  reportDate = '2026-07-14',
  brandKicker = 'DIGITAL MEDICINE',
  brandSubline = 'LLM / AGENT TRACKER'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const reportHref = `${base}report/`;
const literatureHref = `${base}literature/`;
const vlmHref = `${base}vlm/`;
const vlmReportHref = `${base}vlm/report/`;
const surgeryHref = `${base}surgery/`;
const surgeryReportHref = `${base}surgery/report/`;
const primaryReportHref = active === 'vlm' || active === 'vlm-report' || active === 'vlm-literature'
  ? vlmReportHref
  : active === 'surgery' || active === 'surgery-report' || active === 'surgery-literature'
    ? surgeryReportHref
  : reportHref;
const primaryReportLabel = active === 'vlm' || active === 'vlm-report' || active === 'vlm-literature'
  ? '进入 VLM 报告'
  : active === 'surgery' || active === 'surgery-report' || active === 'surgery-literature'
    ? '进入手术 AI 报告'
  : '进入报告';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f3f5f2" />
    <meta name="site-base" content={base} />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body data-base={base}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={base} aria-label="医学人工智能文献追踪首页">
          <span class="brand__mark">npj</span>
          <span class="brand__text">{brandKicker}<br /><small>{brandSubline}</small></span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          <a class:list={['nav-link', { active: active === 'home' }]} href={base}>
            <span>总览</span>
          </a>
          <a class:list={['nav-link', { active: active === 'report' }]} href={reportHref}>
            <BookOpen size={16} strokeWidth={1.8} aria-hidden="true" />
            <span>报告阅读</span>
          </a>
          <a class:list={['nav-link', { active: active === 'literature' }]} href={literatureHref}>
            <Search size={16} strokeWidth={1.8} aria-hidden="true" />
            <span>文献检索</span>
          </a>
          <a class:list={['nav-link', 'nav-link--vlm', { active: active === 'vlm' || active === 'vlm-report' || active === 'vlm-literature' }]} href={vlmHref}>
            <span class="nav-label--wide">VLM / 扩散</span>
            <span class="nav-label--short" aria-hidden="true">VLM</span>
          </a>
          <a class:list={['nav-link', 'nav-link--surgery', { active: active === 'surgery' || active === 'surgery-report' || active === 'surgery-literature' }]} href={surgeryHref}>
            <span class="nav-label--wide">手术 AI</span>
            <span class="nav-label--short" aria-hidden="true">手术</span>
          </a>
        </nav>
        <a class="header-link" href={primaryReportHref}>
          <span>{primaryReportLabel}</span>
          <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" />
        </a>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <strong>{reportLabel}</strong>
          <p>研究信息整理，不构成医疗建议。论文详情请以原始出版物为准。</p>
        </div>
        <div class="site-footer__meta">
          <span>数据源：PubMed / NCBI E-utilities / Crossref</span>
          <span>检索截止：{reportDate}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
